{
  "manifest_version": 3,
  "name": "Video Download Helper Pro",
  "version": "1.0.0",
  "description": "Download videos from websites with support for DASH, HLS, MPD, live streaming, and MP4 conversion",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-simple.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Open Video Download Helper"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Side Panel"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "injected/*.js",
        "injected/core/*.js",
        "injected/detectors/*.js",
        "injected/downloaders/*.js",
        "injected/utils/*.js",
        "modules/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
